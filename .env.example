# Telegram Bot Credentials (Get from @BotFather and @userinfobot)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Location Coordinates (Default: Hyderabad)
BLINKIT_LAT=17.4297
BLINKIT_LON=78.4406
ZEPTO_LAT=17.4297
ZEPTO_LON=78.4406
PINCODE=500073

# Scan Interval in seconds for 24/7 background mode (Default: 300 = 5 minutes)
SCAN_INTERVAL=300

# Proxy Settings (Optional - Not needed when running in India on Raspberry Pi)
# PROXY_SERVER=http://ip:port
# PROXY_USERNAME=
# PROXY_PASSWORD=
