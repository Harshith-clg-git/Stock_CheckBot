[Unit]
Description=Hot Wheels Multi-Platform Stock Checker Bot
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
# Replace 'pi' with your Raspberry Pi username if different
User=pi
WorkingDirectory=/home/pi/Hotwheels_bot
EnvironmentFile=/home/pi/Hotwheels_bot/.env
ExecStart=/home/pi/Hotwheels_bot/venv/bin/python main.py
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
